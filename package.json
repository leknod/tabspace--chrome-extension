{
  "name": "tabspace",
  "version": "0.1.0",
  "private": true,
  "description": "Extension de Chrome de marcadores propios, sincronizados con Google Drive (appDataFolder).",
  "scripts": {
    "dev": "next dev -p 3000",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "gen-key": "node scripts/generate-extension-key.mjs",
    "clean": "node -e \"require('fs').rmSync('out',{recursive:true,force:true});require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "lucide-react": "^1.31.0",
    "next": "^15.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.279",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "dotenv": "^16.4.5",
    "esbuild": "^0.23.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.2"
  }
}
